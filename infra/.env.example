# Runtime examples only. Do not commit populated files or expose server secrets with NEXT_PUBLIC_.
# DataGSM OAuth URLs are handled inside the SDK (DEC-016).
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
DATAGSM_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
PUBLIC_ORIGIN=
DB_URL=jdbc:postgresql://localhost:5433/checkup
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TIMEOUT=7d
SESSION_COOKIE_SECURE=true
# Spring-to-AI internal API. Use the service origin without /health/ready.
FACE_AI_BASE_URL=http://localhost:8000
FACE_SERVICE_TOKEN=
